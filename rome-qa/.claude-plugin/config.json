      "robot": "sarah"
    },
    {
      "id": "quality-gate-p2",
      "path": "skills/quality-gate-p2",
      "category": "Quality Gate",
      "phase": "GATE-P2",
      "robot": "sarah"
    },
    {
      "id": "quality-gate-p3",
      "path": "skills/quality-gate-p3",
