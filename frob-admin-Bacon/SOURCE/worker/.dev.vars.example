# FOB api-worker — local dev secrets template (TDR-11: secrets via Wrangler)
#
# Copy this file to `.dev.vars` (gitignored, NEVER commit it) and fill in
# your own local/sandbox test credentials. This .example file lists SECRET
# NAMES ONLY — no real values, ever. Production/staging equivalents are set
# with `wrangler secret put <NAME> --env staging|production`, never checked
# into source.

# Stripe (TDR-06 Embedded Checkout) — use a Stripe TEST mode key/secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# core-auth (TDR-07 JWT HS256 1h sessions, Owner/customer signed-link)
JWT_SECRET=replace_with_a_long_random_string

# Resend inbound delivery webhooks (CR-011) — signing secret from the Resend
# dashboard, format whsec_<base64>. Without it the webhook refuses everything.
RESEND_WEBHOOK_SECRET=replace_me

# Resend (CHG-008 / REQ-NOTIF01 — outbound transactional email). Only needed
# when EMAIL_TRANSPORT=resend; local default is `debug` (simulated sends).
# Use a Resend TEST key locally, never the production key.
RESEND_API_KEY=
# Optional local override of wrangler.toml's EMAIL_TRANSPORT
# (resend | cloudflare | debug):
EMAIL_TRANSPORT=

# Met Office DataHub (TDR-17 advisory proxy)
MET_OFFICE_KEY=replace_me

# TfL Unified API (TDR-17 advisory proxy)
TFL_APP_KEY=replace_me
