{
  "name": "talib",
  "version": "1.0.0",
  "description": "Talib - Requirements Engineer robot for ROME framework (multi-phase: P1 AORDL, P2 Analysis)",
  "type": "robot-plugin",
  "role": "Requirements Engineer",
  "provides": {
    "robot": "talib",
    "modes": [
      "P1-aordl",
      "P2-analysis"
    ],
    "skills": [
      "create-aordl-requirement",
      "transform-aordl-to-bdd",
      "validate-aordl",
      "analyze-requirement",
      "batch-analyze-requirements",
      "generate-user-stories"
    ]
  },
  "dependencies": {
    "rome-core": "^1.0.0",
    "plugins": [],
    "mcps": [
      "activity-log-file",
      "iterm2-terminal",
      "Seez"
    ]
  },
  "exports": {
    "ROBOT.md": "Core robot identity and baseline behavior",
    "modes/P1-aordl.md": "P1 AORDL requirements capture mode",
    "modes/P2-analysis.md": "P2 requirements analysis and functional decomposition mode",
    "skills/create-aordl-requirement/SKILL.md": "Create AORDL requirement skill",
    "skills/transform-aordl-to-bdd/SKILL.md": "Transform AORDL to BDD skill",
    "skills/validate-aordl/SKILL.md": "Validate AORDL skill",
    "skills/analyze-requirement/SKILL.md": "Analyze requirement skill",
    "skills/batch-analyze-requirements/SKILL.md": "Batch analyze requirements skill",
    "skills/generate-user-stories/SKILL.md": "Generate user stories skill"
  },
  "author": "ROME Framework Team",
  "license": "MIT",
  "keywords": [
    "rome",
    "robot",
    "requirements-engineer",
    "talib",
    "multi-phase",
    "aordl",
    "analysis"
  ]
}
