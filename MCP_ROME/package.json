{
  "name": "mcp-documentation-server",
  "version": "1.0.0",
  "description": "MCP Documentation Server with Vector Search",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --config tests/jest.config.js",
    "test:contracts": "jest --config tests/jest.config.js --testPathPattern=contracts",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "build": "tsc && cd backend && npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "ingest-docs": "cd backend && npm run ingest-docs --",
    "doc-server": "cd backend && npm run doc-server",
    "mcp-server": "cd backend && npm run mcp-server",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "backend:start": "cd backend && npm run start"
  },
  "keywords": [
    "mcp",
    "documentation",
    "vector-search",
    "weaviate",
    "semantic-search"
  ],
  "author": "ROME Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "weaviate-ts-client": "^2.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
