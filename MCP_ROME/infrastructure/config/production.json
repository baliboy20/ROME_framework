{
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "environment": "production"
  },
  "weaviate": {
    "url": "http://weaviate:8080",
    "timeout": 60000,
    "retries": 5
  },
  "openai": {
    "apiKey": "${OPENAI_API_KEY}",
    "model": "text-embedding-ada-002",
    "timeout": 60000
  },
  "logging": {
    "level": "info",
    "format": "json",
    "filename": "logs/production.log"
  },
  "cache": {
    "enabled": true,
    "ttl": 3600,
    "maxSize": 1000
  },
  "processing": {
    "chunkSize": 1500,
    "overlap": 300,
    "maxFileSize": "50MB"
  },
  "health": {
    "timeout": 10000,
    "interval": 30000
  },
  "security": {
    "rateLimit": {
      "windowMs": 900000,
      "max": 100
    },
    "cors": {
      "origin": false,
      "credentials": false
    }
  },
  "monitoring": {
    "metrics": {
      "enabled": true,
      "endpoint": "/metrics"
    },
    "traces": {
      "enabled": true,
      "sampling": 0.1
    }
  }
}