{
  "permissions": {
    "requireConfirmation": false,
    "allow": [
      // === Core Tools ===
      "Read(*)", "LS(*)", "Glob(*)", "Grep(*)", "Task(*)", "TodoWrite(*)",
      
      // === Backend File Access ===
      "Write(**/SOURCE/backend/**)",
      "Write(**/SOURCE/database/**)",
      "Write(**/SOURCE/tests/**)",
      "Write(**/PROJECT/dev/**)",
      "Write(**/claude_backend/**)",
      "Edit(**/SOURCE/backend/**)",
      "Edit(**/SOURCE/database/**)", 
      "Edit(**/SOURCE/tests/**)",
      "Edit(**/PROJECT/dev/**)",
      "Edit(**/claude_backend/**)",
      
      // === Backend Languages ===
      "Write(**/*.js)", "Write(**/*.ts)", "Write(**/*.py)", "Write(**/*.sql)",
      "Edit(**/*.js)", "Edit(**/*.ts)", "Edit(**/*.py)", "Edit(**/*.sql)",
      "Write(**/*.json)", "Write(**/*.yml)", "Write(**/*.yaml)", "Write(**/*.env*)",
      "Edit(**/*.json)", "Edit(**/*.yml)", "Edit(**/*.yaml)", "Edit(**/*.env*)",
      
      // === Backend Development ===
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(yarn:*)",
      "Bash(python:*)", "Bash(python3:*)", "Bash(pip:*)", "Bash(pytest:*)",
      "Bash(uvicorn:*)", "Bash(gunicorn:*)", "Bash(flask:*)", "Bash(django-admin:*)",
      
      // === Database Tools ===
      "Bash(psql:*)", "Bash(mysql:*)", "Bash(sqlite3:*)", "Bash(mongosh:*)",
      
      // === Testing & Quality ===
      "Bash(jest:*)", "Bash(pytest:*)", "Bash(eslint:*)", "Bash(prettier:*)",
      "Bash(npm run test:*)", "Bash(npm run lint:*)", "Bash(npm run build:*)",
      
      // === Basic Operations ===
      "Bash(mkdir:*)", "Bash(mv:*)", "Bash(cp:*)", "Bash(chmod:*)",
      "Bash(git:*)", "Bash(gh:*)"
    ],
    "deny": [
      // === Frontend Files ===
      "Write(**/SOURCE/frontend/**)",
      "Edit(**/SOURCE/frontend/**)",
      
      // === Infrastructure ===
      "Write(**/SOURCE/infrastructure/**)",
      "Edit(**/SOURCE/infrastructure/**)",
      
      // === System Operations ===
      "Bash(sudo:*)", "Bash(docker:*)", "Bash(kubectl:*)",
      
      // === Global Installs ===
      "Bash(npm install -g:*)", "Bash(pip install --user:*)"
    ]
  }
}