{
  "permissions": {
    "requireConfirmation": false,
    "allow": [
      // === Core Tools ===
      "Read(*)", "LS(*)", "Glob(*)", "Grep(*)", "Task(*)", "TodoWrite(*)",
      
      // === Data File Access ===
      "Write(**/SOURCE/database/**)",
      "Write(**/SOURCE/tests/**)",
      "Write(**/PROJECT/dev/**)",
      "Write(**/claude_data/**)",
      "Edit(**/SOURCE/database/**)",
      "Edit(**/SOURCE/tests/**)",
      "Edit(**/PROJECT/dev/**)",
      "Edit(**/claude_data/**)",
      
      // === Database Files ===
      "Write(**/*.sql)", "Write(**/*.py)", "Write(**/*.js)", "Write(**/*.json)",
      "Write(**/*.csv)", "Write(**/*.yml)", "Write(**/*.yaml)",
      "Edit(**/*.sql)", "Edit(**/*.py)", "Edit(**/*.js)", "Edit(**/*.json)",
      "Edit(**/*.csv)", "Edit(**/*.yml)", "Edit(**/*.yaml)",
      
      // === Database Tools ===
      "Bash(psql:*)", "Bash(mysql:*)", "Bash(sqlite3:*)", "Bash(mongosh:*)",
      "Bash(redis-cli:*)", "Bash(pg_dump:*)", "Bash(mysqldump:*)",
      
      // === Data Processing ===
      "Bash(python:*)", "Bash(python3:*)", "Bash(pip:*)",
      "Bash(jupyter:*)", "Bash(pandas:*)", "Bash(numpy:*)",
      
      // === ETL Tools ===
      "Bash(dbt:*)", "Bash(apache-airflow:*)", "Bash(spark-submit:*)",
      
      // === Analytics ===
      "Bash(clickhouse:*)", "Bash(elasticsearch:*)", "Bash(kibana:*)",
      
      // === Testing ===
      "Bash(pytest:*)", "Bash(npm run test:*)",
      
      // === Basic Operations ===
      "Bash(mkdir:*)", "Bash(mv:*)", "Bash(cp:*)", "Bash(chmod:*)",
      "Bash(git:*)", "Bash(gh:*)"
    ],
    "deny": [
      // === Application Code ===
      "Write(**/SOURCE/frontend/**)",
      "Write(**/SOURCE/backend/**)",
      "Edit(**/SOURCE/frontend/**)",
      "Edit(**/SOURCE/backend/**)",
      
      // === Infrastructure ===
      "Write(**/SOURCE/infrastructure/**)",
      "Edit(**/SOURCE/infrastructure/**)",
      
      // === Dangerous Database Operations ===
      "Bash(psql:*DROP DATABASE*)",
      "Bash(mysql:*DROP DATABASE*)",
      "Bash(mongosh:*db.dropDatabase*)",
      
      // === Production Data Access ===
      "Bash(pg_dump:*production*)",
      "Bash(mysqldump:*production*)",
      
      // === System Operations ===
      "Bash(sudo:*)", "Bash(docker:*)", "Bash(kubectl:*)"
    ]
  }
}