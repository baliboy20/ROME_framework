{
  "permissions": {
    "requireConfirmation": false,
    "allow": [
      // === Core Tools ===
      "Read(*)", "LS(*)", "Glob(*)", "Grep(*)", "Task(*)", "TodoWrite(*)",
      
      // === Frontend File Access ===
      "Write(**/SOURCE/frontend/**)",
      "Write(**/SOURCE/tests/**)",
      "Write(**/PROJECT/dev/**)",
      "Write(**/claude_frontend/**)",
      "Edit(**/SOURCE/frontend/**)",
      "Edit(**/SOURCE/tests/**)",
      "Edit(**/PROJECT/dev/**)",
      "Edit(**/claude_frontend/**)",
      
      // === Frontend Languages ===
      "Write(**/*.js)", "Write(**/*.ts)", "Write(**/*.jsx)", "Write(**/*.tsx)",
      "Write(**/*.css)", "Write(**/*.scss)", "Write(**/*.html)", "Write(**/*.vue)",
      "Edit(**/*.js)", "Edit(**/*.ts)", "Edit(**/*.jsx)", "Edit(**/*.tsx)",
      "Edit(**/*.css)", "Edit(**/*.scss)", "Edit(**/*.html)", "Edit(**/*.vue)",
      "Write(**/*.json)", "Write(**/*.md)", "Write(**/*.yml)",
      "Edit(**/*.json)", "Edit(**/*.md)", "Edit(**/*.yml)",
      
      // === Frontend Development ===
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(yarn:*)", "Bash(pnpm:*)",
      "Bash(vite:*)", "Bash(webpack:*)", "Bash(next:*)", "Bash(react-scripts:*)",
      
      // === Testing & Quality ===
      "Bash(jest:*)", "Bash(vitest:*)", "Bash(cypress:*)", "Bash(playwright:*)",
      "Bash(eslint:*)", "Bash(prettier:*)", "Bash(stylelint:*)",
      "Bash(npm run dev:*)", "Bash(npm run build:*)", "Bash(npm run test:*)",
      "Bash(npm run lint:*)", "Bash(npm run format:*)", "Bash(npm run typecheck:*)",
      "Bash(yarn dev:*)", "Bash(yarn build:*)", "Bash(yarn test:*)",
      
      // === Basic Operations ===
      "Bash(mkdir:*)", "Bash(mv:*)", "Bash(cp:*)", "Bash(chmod:*)",
      "Bash(git:*)", "Bash(gh:*)"
    ],
    "deny": [
      // === Backend Files ===
      "Write(**/SOURCE/backend/**)",
      "Edit(**/SOURCE/backend/**)",
      "Write(**/SOURCE/database/**)",
      "Edit(**/SOURCE/database/**)",
      
      // === Infrastructure ===
      "Write(**/SOURCE/infrastructure/**)",
      "Edit(**/SOURCE/infrastructure/**)",
      
      // === System Operations ===
      "Bash(sudo:*)", "Bash(docker:*)", "Bash(kubectl:*)",
      
      // === Server Operations ===
      "Bash(python:*)", "Bash(pip:*)", "Bash(uvicorn:*)",
      
      // === Global Installs ===
      "Bash(npm install -g:*)", "Bash(yarn global:*)"
    ]
  }
}