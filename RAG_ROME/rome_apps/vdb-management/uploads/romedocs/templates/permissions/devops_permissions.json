{
  "permissions": {
    "requireConfirmation": false,
    "allow": [
      // === Core Tools ===
      "Read(*)", "LS(*)", "Glob(*)", "Grep(*)", "Task(*)", "TodoWrite(*)",
      
      // === DevOps File Access ===
      "Write(**/SOURCE/infrastructure/**)",
      "Write(**/SOURCE/tests/**)",
      "Write(**/PROJECT/dev/**)",
      "Write(**/claude_devops/**)",
      "Edit(**/SOURCE/infrastructure/**)",
      "Edit(**/SOURCE/tests/**)",
      "Edit(**/PROJECT/dev/**)",
      "Edit(**/claude_devops/**)",
      
      // === Infrastructure Files ===
      "Write(**/*.yml)", "Write(**/*.yaml)", "Write(**/*.json)",
      "Write(**/*.tf)", "Write(**/*.hcl)", "Write(**/Dockerfile)",
      "Write(**/docker-compose.yml)", "Write(**/*.sh)", "Write(**/*.env*)",
      "Edit(**/*.yml)", "Edit(**/*.yaml)", "Edit(**/*.json)",
      "Edit(**/*.tf)", "Edit(**/*.hcl)", "Edit(**/Dockerfile)",
      "Edit(**/docker-compose.yml)", "Edit(**/*.sh)", "Edit(**/*.env*)",
      
      // === Container & Orchestration ===
      "Bash(docker:*)", "Bash(docker-compose:*)", "Bash(podman:*)",
      "Bash(kubectl:*)", "Bash(helm:*)",
      
      // === Infrastructure as Code ===
      "Bash(terraform:*)", "Bash(ansible:*)", "Bash(packer:*)",
      
      // === Cloud Platforms ===
      "Bash(aws:*)", "Bash(gcloud:*)", "Bash(az:*)",
      
      // === Monitoring & Logging ===
      "Bash(prometheus:*)", "Bash(grafana:*)", "Bash(elasticsearch:*)",
      
      // === System Monitoring ===
      "Bash(ps:*)", "Bash(top)", "Bash(htop)", "Bash(netstat:*)",
      "Bash(lsof:*)", "Bash(df:*)", "Bash(du:*)", "Bash(free:*)",
      
      // === Network Tools ===
      "Bash(curl:*)", "Bash(wget:*)", "Bash(ping:*)", "Bash(telnet:*)",
      
      // === Basic Operations ===
      "Bash(mkdir:*)", "Bash(mv:*)", "Bash(cp:*)", "Bash(chmod:*)",
      "Bash(git:*)", "Bash(gh:*)"
    ],
    "deny": [
      // === Application Code ===
      "Write(**/SOURCE/frontend/**)",
      "Write(**/SOURCE/backend/**)",
      "Edit(**/SOURCE/frontend/**)",
      "Edit(**/SOURCE/backend/**)",
      
      // === Dangerous System Operations ===
      "Bash(sudo systemctl:*)", "Bash(systemctl stop:*)",
      "Bash(rm -rf /*)", "Bash(chmod 777:*)",
      
      // === Production Operations (require approval) ===
      "Bash(kubectl delete:*)", "Bash(terraform destroy:*)",
      "Bash(aws s3 rm:*)", "Bash(docker system prune:*)"
    ]
  }
}