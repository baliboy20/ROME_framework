{
  "name": "rome-vdb-management-service",
  "version": "1.0.0",
  "description": "ROME Vector Database Management Service - Document storage and coordination tracking",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "docker:build": "docker build -t rome-vdb-service .",
    "docker:run": "docker run -p 8080:8080 rome-vdb-service"
  },
  "keywords": [
    "vector-database",
    "weaviate",
    "rome-methodology",
    "document-management",
    "coordination-tracking",
    "semantic-search"
  ],
  "author": "ROME Development Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "graphql": "^16.0.0",
    "helmet": "^7.0.0",
    "isomorphic-fetch": "^3.0.0",
    "morgan": "^1.10.0",
    "rifraf": "^2.0.3",
    "tsx": "^4.20.3",
    "weaviate-ts-client": "^1.4.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
