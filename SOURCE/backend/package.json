{
  "name": "mcp-documentation-server",
  "version": "1.0.0",
  "description": "MCP Documentation Server for Flutter development with semantic search",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "ingest-docs": "tsx src/cli/ingest-docs.ts",
    "doc-server": "tsx src/api/DocumentAPI.ts",
    "mcp-server": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "flutter",
    "semantic-search",
    "vector-database"
  ],
  "author": "Reena (Backend Developer)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "multer": "^2.0.2",
    "weaviate-ts-client": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.0.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
