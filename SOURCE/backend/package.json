{
  "name": "project-management-api",
  "version": "1.0.0",
  "description": "Project Management Application Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "express",
    "mongodb",
    "api",
    "project-management",
    "rome-methodology"
  ],
  "author": "ROME DevOps Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "express-validator": "^7.0.1",
    "graceful-fs": "^4.2.11",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "streamx": "^2.22.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tar-stream": "^3.1.7",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "eslint": "^8.47.0",
    "eslint-config-node": "^4.1.0",
    "eslint-plugin-jest": "^27.2.3",
    "jest": "^29.6.4",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/backend-server.test.js",
      "**/tests/unit/*Controller.test.js",
      "**/tests/unit/models.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/../tests/setup.js"
    ],
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "./**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!./server.js",
      "!./logs/**",
      "!./uploads/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "verbose": true,
    "detectOpenHandles": true,
    "forceExit": true
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
