{
  "name": "mfe-backend",
  "version": "1.0.0",
  "description": "Backend API for Medium Flutter Link Extractor",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node build.js",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "docker:build": "docker build -t mfe-backend .",
    "docker:dev": "docker build -f Dockerfile.dev -t mfe-backend-dev . && docker run -p 3000:3000 mfe-backend-dev"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.0.19",
    "cheerio": "^1.0.0-rc.12",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^9.6.3",
    "googleapis": "^134.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "marked": "^12.0.1",
    "mongodb": "^6.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "p-queue": "^8.0.1",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "readability-extractor": "^0.0.6",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.33.3",
    "socket.io": "^4.7.5",
    "turndown": "^7.2.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module",
      "project": "./tsconfig.json"
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/explicit-module-boundary-types": "off"
    },
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    }
  },
  "keywords": [
    "express",
    "typescript",
    "esm",
    "gmail-api",
    "puppeteer",
    "mongodb",
    "scraper"
  ],
  "author": "ROME Development Team",
  "license": "MIT"
}
