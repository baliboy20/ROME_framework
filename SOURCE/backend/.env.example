# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/medium_extractor
MONGODB_DB_NAME=medium_extractor

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Application Configuration
APP_NAME=Medium Flutter Extractor
APP_VERSION=1.0.0

# Token Storage
TOKEN_STORAGE_PATH=./data/tokens

# Scraping Configuration
SCRAPING_TIMEOUT=30000
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100