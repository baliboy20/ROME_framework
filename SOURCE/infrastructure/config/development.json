{
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "environment": "development"
  },
  "weaviate": {
    "url": "http://localhost:8080",
    "timeout": 30000,
    "retries": 3
  },
  "openai": {
    "apiKey": "${OPENAI_API_KEY}",
    "model": "text-embedding-ada-002",
    "timeout": 30000
  },
  "logging": {
    "level": "debug",
    "format": "dev",
    "filename": "logs/development.log"
  },
  "cache": {
    "enabled": true,
    "ttl": 300,
    "maxSize": 100
  },
  "processing": {
    "chunkSize": 1000,
    "overlap": 200,
    "maxFileSize": "10MB"
  },
  "health": {
    "timeout": 5000,
    "interval": 10000
  }
}