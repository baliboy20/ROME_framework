{
  "name": "flutter-mcp-server",
  "version": "1.0.0",
  "description": "Flutter MCP Expert Server with Vector Search",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --config tests/jest.config.js",
    "test:contracts": "jest --config tests/jest.config.js --testPathPattern=contracts",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:flutter": "tsx test-flutter-mcp.ts",
    "test:setup": "./test-setup.sh",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "ingest": "WEAVIATE_PORT=8088 npm run ingest-docs -- ../documents/flutter",
    "ingest-docs": "cd backend && npm run ingest-docs",
    "ingest-clear": "cd backend && npm run ingest-docs --  --clear",
    "server": "cd backend && npm run mcp-server",
    "docker:up": "cd infrastructure/docker && docker-compose up -d",
    "docker:down": "cd infrastructure/docker && docker-compose down",
    "docker:logs": "docker logs -f shared-vdb"
  },
  "keywords": [
    "mcp",
    "documentation",
    "vector-search",
    "weaviate",
    "semantic-search"
  ],
  "author": "ROME Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "weaviate-ts-client": "^2.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.9",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
