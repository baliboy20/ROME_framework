{
  "server": {
    "port": 3040,
    "host": "localhost",
    "environment": "development"
  },
  "weaviate": {
    "url": "http://localhost:8088",
    "timeout": 5000,
    "retries": 3
  },
  "openai": {
    "apiKey": "${OPENAI_API_KEY}",
    "model": "text-embedding-ada-002",
    "timeout": 30000
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "filename": "app.log"
  },
  "cache": {
    "enabled": true,
    "ttl": 3600,
    "maxSize": 1000
  },
  "processing": {
    "chunkSize": 1000,
    "overlap": 100,
    "maxFileSize": "10MB"
  },
  "health": {
    "timeout": 5000,
    "interval": 30000
  },
  "security": {
    "rateLimit": {
      "windowMs": 900000,
      "max": 100
    },
    "cors": {
      "origin": true,
      "credentials": false
    }
  },
  "monitoring": {
    "metrics": {
      "enabled": true,
      "endpoint": "/metrics"
    },
    "traces": {
      "enabled": false,
      "sampling": 0.1
    }
  }
}