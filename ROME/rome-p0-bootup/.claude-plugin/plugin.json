{
  "name": "rome-p0-bootup",
  "version": "1.0.0",
  "description": "ROME Phase 0 (Bootup) - Project initialization and bootstrap",
  "type": "phase-plugin",
  "phase": "P00-bootup",
  "provides": {
    "agents": [
      "bootstrap"
    ],
    "skills": [],
    "commands": [
      "rome-p0:bootstrap"
    ]
  },
  "dependencies": {
    "rome-core": "^1.0.0"
  },
  "requires": {
    "mcpServers": [
      {
        "name": "activity-log-file",
        "reason": "Track bootstrap phase progress and log project initialization events",
        "optional": false
      },
      {
        "name": "Seez",
        "reason": "Notify sponsor of project initialization completion",
        "optional": false
      },
      {
        "name": "rome-terminal",
        "reason": "Validate terminal connectivity during bootstrap",
        "optional": true
      }
    ]
  },
  "exports": {
    "agents/bootstrap/AGENT.md": "Bootstrap agent for project initialization",
    "commands/rome-p0-bootstrap.md": "Slash command for project bootstrap"
  },
  "author": "ROME Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rome-framework/rome-p0-bootup"
  },
  "keywords": [
    "rome",
    "phase-0",
    "bootup",
    "bootstrap",
    "project-initialization"
  ]
}
