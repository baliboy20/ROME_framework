{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/init-workspace.sh\"",
            "description": "Initialize P5 multi-robot workspace (Ashok, Reena, Charlie)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../rome-core/.claude/hooks/check-activity-log.sh\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
