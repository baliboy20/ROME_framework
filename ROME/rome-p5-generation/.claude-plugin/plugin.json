{
  "name": "rome-p5-generation",
  "version": "1.0.0",
  "description": "ROME Phase 5 Generation plugin - Parallel code generation for Database, API, and UI layers",
  "type": "phase-plugin",
  "phase": "P05-generation",
  "provides": {
    "orchestration": "P5 true parallel code generation - all robots start simultaneously",
    "workflows": [
      "parallel-generation"
    ],
    "commands": [
      "rome-p5:generate-db",
      "rome-p5:generate-api",
      "rome-p5:generate-ui",
      "rome-p5:parallel-generate",
      "rome-p5:status",
      "switch-robot"
    ]
  },
  "dependencies": {
    "rome-core": "^1.0.0",
    "robot-plugins/ashok": "^1.0.0",
    "robot-plugins/reena": "^1.0.0",
    "robot-plugins/charlie": "^1.0.0"
  },
  "peerDependencies": {
    "rome-p4-config": ">=1.0.0"
  },
  "requires": {
    "robots": [
      {
        "name": "ashok",
        "mode": "P5-generation",
        "source": "robot-plugins/ashok",
        "expectedSkills": ["generate-database-schema", "generate-migrations", "generate-orm-models", "generate-seed-data"]
      },
      {
        "name": "reena",
        "mode": "P5-generation",
        "source": "robot-plugins/reena",
        "expectedSkills": ["generate-api-endpoints", "generate-authentication-middleware"]
      },
      {
        "name": "charlie",
        "mode": "P5-generation",
        "source": "robot-plugins/charlie",
        "expectedSkills": ["generate-ui-screens", "generate-ui-components"]
      }
    ],
    "mcpServers": [
      {
        "name": "activity-log-file",
        "reason": "Track code generation work items for parallel backend/frontend/integration tasks",
        "optional": false
      },
      {
        "name": "iterm2-terminal",
        "reason": "Create multi-robot workspace for parallel code generation",
        "optional": true
      },
      {
        "name": "Seez",
        "reason": "Request sponsor clarification on implementation details and edge cases",
        "optional": false
      }
    ]
  },
  "exports": {
    ".claude/hooks/init-workspace.sh": "Multi-robot workspace initialization hook",
    "commands/switch-robot.sh": "Switch between robots in P5 phase",
    "commands/rome-p5-parallel-generate.sh": "Launch all robots with dependency coordination",
    "commands/rome-p5-status.sh": "Monitor P5 parallel generation progress"
  },
  "framework": {
    "name": "ROME",
    "version": "v3",
    "compatibility": "^3.0.0"
  },
  "author": "ROME Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rome-framework/rome-p5-generation"
  },
  "keywords": [
    "rome",
    "framework",
    "phase5",
    "generation",
    "code-generation",
    "database",
    "api",
    "ui"
  ]
}
