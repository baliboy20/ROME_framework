{
  "name": "rome-p5-generation",
  "version": "1.0.0",
  "description": "ROME Phase 5 Generation plugin - Parallel code generation for Database, API, and UI layers",
  "type": "phase-plugin",
  "phase": "P05-generation",
  "provides": {
    "skills": [
      "generate-database-schema",
      "generate-migrations",
      "generate-orm-models",
      "generate-seed-data",
      "generate-api-endpoints",
      "generate-authentication-middleware",
      "generate-ui-screens",
      "generate-ui-components"
    ],
    "commands": [
      "rome-p5:generate-db",
      "rome-p5:generate-api",
      "rome-p5:generate-ui"
    ]
  },
  "dependencies": {
    "rome-core": "^1.0.0",
    "robot-plugins/ashok": "^1.0.0",
    "robot-plugins/reena": "^1.0.0",
    "robot-plugins/charlie": "^1.0.0"
  },
  "peerDependencies": {
    "rome-p4-config": ">=1.0.0"
  },
  "requires": {
    "robots": [
      {
        "name": "ashok",
        "mode": "P5-generation",
        "source": "robot-plugins/ashok"
      },
      {
        "name": "reena",
        "mode": "P5-generation",
        "source": "robot-plugins/reena"
      },
      {
        "name": "charlie",
        "mode": "P5-generation",
        "source": "robot-plugins/charlie"
      }
    ],
    "mcpServers": [
      {
        "name": "activity-log-file",
        "reason": "Track code generation work items for parallel backend/frontend/integration tasks",
        "optional": false
      },
      {
        "name": "Seez",
        "reason": "Request sponsor clarification on implementation details and edge cases",
        "optional": false
      }
    ]
  },
  "exports": {
    "skills/generate-database-schema/SKILL.md": "Generate database schema from data dictionary",
    "skills/generate-migrations/SKILL.md": "Generate database migrations",
    "skills/generate-orm-models/SKILL.md": "Generate ORM models",
    "skills/generate-seed-data/SKILL.md": "Generate seed data",
    "skills/generate-api-endpoints/SKILL.md": "Generate API endpoints",
    "skills/generate-authentication-middleware/SKILL.md": "Generate authentication middleware",
    "skills/generate-ui-screens/SKILL.md": "Generate UI screens",
    "skills/generate-ui-components/SKILL.md": "Generate UI components"
  },
  "framework": {
    "name": "ROME",
    "version": "v3",
    "compatibility": "^3.0.0"
  },
  "author": "ROME Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rome-framework/rome-p5-generation"
  },
  "keywords": [
    "rome",
    "framework",
    "phase5",
    "generation",
    "code-generation",
    "database",
    "api",
    "ui"
  ]
}
