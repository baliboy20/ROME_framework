{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/../robot-plugins/lucien/ROBOT.md\" && echo '\n---\n' && cat \"$CLAUDE_PROJECT_DIR/../robot-plugins/lucien/modes/P4-config.md\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../rome-core/.claude/hooks/check-activity-log.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__activity-log-file__append",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../rome-core/.claude/hooks/reject-zero-timestamps.sh\"",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
