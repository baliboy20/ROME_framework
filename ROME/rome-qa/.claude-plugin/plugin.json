{
  "name": "rome-qa",
  "version": "1.0.0",
  "description": "ROME Quality Assurance plugin - Quality gates and validation across all phases",
  "type": "cross-phase-plugin",
  "provides": {
    "skills": [
      "validate-aordl-structure",
      "validate-requirements-coverage",
      "validate-data-dictionary",
      "quality-gate-p2",
      "quality-gate-p3",
      "verify-traceability"
    ],
    "commands": [
      "rome-qa:validate",
      "rome-qa:quality-gate"
    ]
  },
  "dependencies": {
    "rome-core": "^1.0.0",
    "robot-plugins/sarah": "^1.0.0"
  },
  "peerDependencies": {},
  "requires": {
    "robots": [
      {
        "name": "sarah",
        "mode": "phase-agnostic",
        "source": "robot-plugins/sarah"
      }
    ],
    "mcpServers": [
      {
        "name": "activity-log-file",
        "reason": "Track quality gate validations and phase transition approvals/blocks",
        "optional": false
      },
      {
        "name": "Seez",
        "reason": "Notify sponsor of quality gate results and critical validation failures",
        "optional": false
      }
    ]
  },
  "exports": {
    "skills/validate-aordl-structure/SKILL.md": "Validate AORDL structure",
    "skills/validate-requirements-coverage/SKILL.md": "Validate requirements coverage",
    "skills/validate-data-dictionary/SKILL.md": "Validate data dictionary",
    "skills/quality-gate-p2/SKILL.md": "Quality gate for P2 phase transition",
    "skills/quality-gate-p3/SKILL.md": "Quality gate for P3 phase transition",
    "skills/verify-traceability/SKILL.md": "Verify traceability across phases"
  },
  "framework": {
    "name": "ROME",
    "version": "v3",
    "compatibility": "^3.0.0"
  },
  "author": "ROME Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rome-framework/rome-qa"
  },
  "keywords": [
    "rome",
    "framework",
    "qa",
    "quality-assurance",
    "validation",
    "quality-gates"
  ]
}
